SECRET_KEY=replace_with_a_secure_random_secret
MONGO_URI=paste_your_atlas_connection_string_here
MONGO_DB_NAME=human_anomaly_db
MONGO_TIMEOUT_MS=1500
MONGO_RETRY_INTERVAL_SECONDS=5
LOCAL_FALLBACK_PATH=instance/local_history.json
MAX_UPLOAD_MB=250
SAMPLE_EVERY_SECONDS=1.0
# Active ROI tracking uses this denser cadence (only when an enabled zone exists).
ZONE_TRACK_SAMPLE_SECONDS=0.5
ZONE_ENTRY_CONFIRMATION_FRAMES=2
ZONE_EXIT_CONFIRMATION_FRAMES=2
ZONE_TRACK_MAX_GAP_SECONDS=1.5
ZONE_BOUNDARY_MARGIN_PX=8
MAX_DURATION_SECONDS=900
ANNOTATED_OUTPUT_MAX_WIDTH=640
PROCESSING_WORKERS=1
PROCESSING_QUEUE_SIZE=3
# Optional: absolute path to locally downloaded YOLO26 pose weights (see README).
POSE_MODEL_PATH=
POSE_TRACKER=bytetrack.yaml
FALL_TRANSITION_WINDOW_SECONDS=1.5
FALL_MIN_VERTICAL_DROP=0.12
FALL_MIN_HORIZONTAL_PERSISTENCE=0.6
FALL_CANDIDATE_SCORE_THRESHOLD=0.55
# Optional object detection/tracking. Use a local COCO-trained Ultralytics detect weight file.
# The website does not download object model weights automatically.
OBJECT_MODEL_PATH=
OBJECT_MODEL_CONFIDENCE=0.25
OBJECT_TRACKER=bytetrack.yaml
# Optional temporal fighting/violence-activity classifier. Weights are local and are not downloaded at startup.
FIGHT_DETECTION_ENABLED=1
FIGHT_MODEL_PATH=models/final_x3d_realtime.pt
FIGHT_SCORE_THRESHOLD=0.4
FIGHT_WINDOW_SECONDS=4.0
FIGHT_WINDOW_STRIDE=1.0
FIGHT_CONFIRMATION_WINDOWS=2
FIGHT_DEVICE=auto
# Email alerts are opt-in. Add real values only to your ignored local .env file.
EMAIL_ALERTS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
ALERT_SENDER_EMAIL=
ALERT_RECIPIENT_EMAILS=
ALERT_SMTP_TIMEOUT_SECONDS=10
ALERT_MAX_GIF_BYTES=3145728
ALERT_GIF_WIDTH=320
ALERT_EPISODE_MERGE_GAP_SECONDS=1.0
ALERT_EVIDENCE_DIR=instance/alert_evidence
# Optional override. Blank uses haarcascade_frontalface_default.xml bundled with opencv-python.
FACE_CASCADE_PATH=
FLASK_DEBUG=0
